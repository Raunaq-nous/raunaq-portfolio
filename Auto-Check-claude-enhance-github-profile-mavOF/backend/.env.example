# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=[".pptx",".pdf"]

# Storage
CHROMA_PERSIST_DIR=./chroma_db
TEMP_DIR=./temp

# OpenAI (Required for language checks)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.7

# Rule Engine Settings
WCAG_NORMAL_TEXT_RATIO=4.5
WCAG_LARGE_TEXT_RATIO=3.0
MIN_FONT_SIZE_LARGE=18

# Language Check Settings
GRAMMAR_CONFIDENCE_THRESHOLD=0.85
STYLE_GUIDE_DEFAULT=microsoft

# Numeric Validation
NUMERIC_TOLERANCE=0.01

# Logging
LOG_LEVEL=INFO
