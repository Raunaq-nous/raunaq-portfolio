{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "source venv/bin/activate && uvicorn app.main:app --reload --port 8000",
      "windows": {
        "command": "venv\\Scripts\\activate && uvicorn app.main:app --reload --port 8000"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "server"
      },
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "server"
      }
    },
    {
      "label": "Start Both (Backend + Frontend)",
      "dependsOn": [
        "Start Backend",
        "Start Frontend"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Install Backend Dependencies",
      "type": "shell",
      "command": "source venv/bin/activate && pip install -r requirements.txt && python -m spacy download en_core_web_sm",
      "windows": {
        "command": "venv\\Scripts\\activate && pip install -r requirements.txt && python -m spacy download en_core_web_sm"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Setup Test",
      "type": "shell",
      "command": "./test_setup.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Run Tests",
      "type": "shell",
      "command": "source venv/bin/activate && pytest tests/ -v --cov=app",
      "windows": {
        "command": "venv\\Scripts\\activate && pytest tests/ -v --cov=app"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Pull Ollama Models",
      "type": "shell",
      "command": "ollama pull llama3:8b && ollama pull nomic-embed-text",
      "problemMatcher": []
    },
    {
      "label": "Apply Performance Profile (Balanced)",
      "type": "shell",
      "command": "curl -X POST 'http://localhost:8000/api/performance/profiles/apply' -H 'Content-Type: application/json' -d '{\"profile\": \"balanced\"}'",
      "problemMatcher": []
    },
    {
      "label": "Check Performance",
      "type": "shell",
      "command": "curl http://localhost:8000/api/performance/benchmark | python3 -m json.tool",
      "problemMatcher": []
    }
  ]
}
